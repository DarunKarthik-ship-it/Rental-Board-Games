# Copy to .env and adjust. Never commit the real .env.

# Server
PORT=4173
HOST=0.0.0.0
NODE_ENV=development

# SQLite database file (directory is created automatically)
DATABASE_PATH=./data/rentals.sqlite

# REQUIRED in production: long random string used to sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Send the session cookie only over HTTPS. Defaults to true when NODE_ENV=production.
# Set to false only if you run production behind plain HTTP.
COOKIE_SECURE=

# Set to 1 when running behind a reverse proxy / load balancer (needed for correct client IPs
# in rate limiting and for secure cookies).
TRUST_PROXY=

# Hours a Pending booking request holds inventory before it stops blocking other customers.
PENDING_HOLD_HOURS=24

# Seed script safety: required to run `npm run seed` when NODE_ENV=production.
# ALLOW_SEED_IN_PRODUCTION=1
